description: Backend rules (FastAPI, SQLAlchemy 2, Neon Postgres, Vercel serverless, Cloudflare R2)
globs: app/**/*.py,alembic/**/*.py,scripts/**/*.py,requirements.txt,vercel.json
alwaysApply: false
